# Toolchain image for cross-compiling the Windows video-helper sidecar on Linux,
# matching CI's MSYS2/MINGW64 build (scripts/build-windows-videohelper-local.sh).
# Apt-only (empty build context, fed on stdin), like the other toolchain images.
# The MSYS2 dep sysroot + build tree live in the bind-mounted repo, not the image.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      g++-mingw-w64-x86-64 gcc-mingw-w64-x86-64 \
      build-essential cmake ninja-build pkgconf git ca-certificates ccache python3 \
      libasound2-dev libfreetype6-dev libfontconfig1-dev libx11-dev libxrandr-dev libxinerama-dev \
      libxcursor-dev libgl-dev libcurl4-openssl-dev \
      curl zstd xz-utils p7zip-full \
    && rm -rf /var/lib/apt/lists/* \
    # Default the cross gcc/g++ to the POSIX-threads variant (std::thread).
    && update-alternatives --set x86_64-w64-mingw32-gcc /usr/bin/x86_64-w64-mingw32-gcc-posix \
    && update-alternatives --set x86_64-w64-mingw32-g++ /usr/bin/x86_64-w64-mingw32-g++-posix
